{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:static",
  "outputDirectory": "public",
  "framework": null,
  "rewrites": [
    {
      "source": "/data.json",
      "destination": "/api/data"
    }
  ],
  "functions": {
    "api/data.ts": {
      "maxDuration": 15
    }
  },
  "cleanUrls": true
}
