# 1inch Developer Portal API key (required for collect + fusion smoke tests)
ONEINCH_API_KEY=

# KalqiX API credentials (optional; unlock the account's effective taker fee
# and the authenticated order-book endpoint, which may return more depth)
KALQIX_API_KEY=
KALQIX_API_SECRET=

# Bebop Price API key (optional; enables the Bebop venue via their sanctioned
# streaming depth feed - without it the Bebop columns stay empty)
BEBOP_API_KEY=

# Chain profile: base (default) or ethereum. Each chain gets its own collector
# process, DB and dashboard port; run one collector per chain, e.g.
#   caffeinate -is npm run collect                   # Base -> ./shadow.sqlite, dash :8787
#   CHAIN=ethereum caffeinate -is npm run collect    # Ethereum -> ./shadow-eth.sqlite, dash :8788
# (report and dash honor CHAIN the same way)
CHAIN=

# JSON-RPC endpoints (optional; defaults: https://mainnet.base.org / https://ethereum-rpc.publicnode.com)
BASE_RPC_URL=
ETH_RPC_URL=

# SQLite database path (optional, defaults to ./shadow.sqlite or ./shadow-eth.sqlite by chain)
DB_PATH=
