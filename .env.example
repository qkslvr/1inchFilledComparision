# Postgres connection (required by the collector, the report and the dashboard).
# Railway gives you two URLs:
#   - the private one (*.railway.internal) for services inside Railway
#   - the public proxy for anything outside it, including the collector VM and Vercel
# Vercel should get a read-only role, not this one:
#   CREATE ROLE vercel_ro LOGIN PASSWORD '...';
#   GRANT USAGE ON SCHEMA chain_8453, chain_1 TO vercel_ro;
#   GRANT SELECT ON ALL TABLES IN SCHEMA chain_8453, chain_1 TO vercel_ro;
DATABASE_URL=

# 1inch Developer Portal API key (required for collect + fusion smoke tests)
ONEINCH_API_KEY=

# KalqiX API credentials (optional; unlock the account's effective taker fee
# and the authenticated order-book endpoint, which may return more depth)
KALQIX_API_KEY=
KALQIX_API_SECRET=

# Bebop Price API key (optional; enables the Bebop venue via their sanctioned
# streaming depth feed - without it the Bebop columns stay empty)
BEBOP_API_KEY=

# Chain profile: base (default) or ethereum. Each chain gets its own collector
# process and its own Postgres schema (chain_8453 / chain_1); run one collector
# per chain, e.g.
#   npm run collect                   # Base     -> schema chain_8453, dash :8787
#   CHAIN=ethereum npm run collect    # Ethereum -> schema chain_1,    dash :8788
# (report and dash honor CHAIN the same way; the dashboard shows every chain
# whose schema exists, regardless of which one CHAIN names)
CHAIN=

# JSON-RPC endpoints (optional; defaults: https://mainnet.base.org / https://ethereum-rpc.publicnode.com)
BASE_RPC_URL=
ETH_RPC_URL=

# Local dashboard bind address (optional; defaults 127.0.0.1:8787)
DASH_HOST=
DASH_PORT=
